  m_text: "[\uC9C0\uCE68\uC11C: \uD53D\uC11C \uC6B4\uC6A9 \uD6A8\uC728\uD654]\n\n\uBAA8\uB4E0
    \uD53D\uC11C\uC5D0\uAC8C\uB294 \uAC01\uC790 \uCD5C\uC801\uD654\uB41C \uC804\uACF5
    \uBD84\uC57C\uAC00 \uC874\uC7AC\uD55C\uB2E4.\n\uC784\uBB34 \uD558\uB2EC \uC2DC
    \uC774\uB4E4\uC758 \uC801\uC131\uC744 \uACE0\uB824\uD558\uC5EC \uBC30\uCE58\uD560
    \uAC83. \uC774\uB294 \uC791\uC5C5 \uC131\uACF5\uB960 \uBC0F \uC5C5\uBB34 \uD6A8\uC728\uC744
