  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uC6B0\uB9AC\uAC00 \uBA87 \uB2EC\uC744 \uB9E4\uB2EC\uB824\uC57C \uD560
    \uC815\uBC00 \uC7A5\uBE44\uB098 \uAD6C\uC870\uBB3C\uB3C4, \uD53D\uC11C\uB4E4\uC5D0\uAC90
    \uADF8\uC800 \uBA87 \uBD84\uC9DC\uB9AC \uC791\uC5C5\uC774\uB2E4.\r\n\r\n\uC2E0\uAE30\uD55C
    \uAC74 \uC790\uC6D0\uC774 \uC804\uD600 \uB4E4\uC9C0 \uC54A\uB294\uB2E4\uB294
    \uC810\uC774\uB2E4. \uBD80\uD488\uC744 \uAD50\uCCB4\uD558\uAC70\uB098 \uC6A9\uC811\uD560
    \uD544\uC694\uB3C4 \uC5C6\uC774, \uC190\uB9CC \uB300\uBA74 \uD30C\uC190\uB41C
    \uCCA0\uD310\uACFC \uD68C\uB85C\uAC00 \uC54C\uC544\uC11C \uC81C\uC790\uB9AC\uB97C
    \uCC3E\uB294\uB2E4. \uC791\uC5C5 \uC18D\uB3C4 \uC5ED\uC2DC \uC6B0\uB9AC\uC640
    \uBE44\uD560 \uBC14\uAC00 \uC544\uB2C8\uB2E4.\r\n\r\n\uC9C0\uAE08 \uADF8 \uD53D\uC11C\uB4E4\uC740
    \uAD73\uAC8C \uC7A0\uAE34 \uBC29 \uC548\uC5D0 \uBCF4\uAD00\uB418\uC5B4 \uC788\uB2E4.\r\n\r\n\uBC29
    \uBE44\uBC00\uBC88\uD638\uB294 \uB0B4\uAC00 \uB0A8\uACA8\uB454 \uBA54\uBAA8 \uC911
    \uD558\uB098\uC5D0 \uC228\uACA8\uB450\uC5C8\uB2E4. \uB4B7\uBA74\uC744 \uC798
    \uC0B4\uD3B4\uBCF4\uBA74 \uBC88\uD638\uB97C \uCC3E\uC544\uB0BC \uC218 \uC788\uC744
    \uAC83\uC774\uB2E4.\r\n\r\n\uD53D\uC11C\uB4E4\uC744 \uD480\uC5B4\uC8FC\uBA74
    \uBCF5\uAD6C \uC791\uC5C5\uC740 \uC555\uB3C4\uC801\uC73C\uB85C \uBE68\uB77C\uC9C0\uACA0\uC9C0\uB9CC...
    \uB188\uB4E4\uC774 \uC6C0\uC9C1\uC774\uB294 \uB3D9\uB825\uC774 \uBB34\uC5C7\uC778\uC9C0\uB294
    \uC544\uC9C1 \uBC1D\uD600\uC9C0\uC9C0 \uC54A\uC558\uB2E4. "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: bcac2079c655a9f468c3df08f5d60d59, type: 2}
